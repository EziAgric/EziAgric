NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_FREIGHTER_ENABLED=true
NEXT_PUBLIC_ALBEDO_URL=https://albedo.link
NEXT_PUBLIC_API_URL=http://localhost:4000
# Version prefix for consumer-facing API calls. Leave as /api/v1 to use the
# versioned backend lane. Set empty (NEXT_PUBLIC_API_VERSION_PREFIX=) to fall
# back to the legacy unversioned aliases (deprecated).
NEXT_PUBLIC_API_VERSION_PREFIX=/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated Stellar public keys allowed to see admin UI (role badge, audit history panel).
# Should match the backend's ADMIN_STELLAR_PUBKEYS allowlist.
NEXT_PUBLIC_ADMIN_WALLETS=
PINATA_JWT=
PINATA_GATEWAY_URL=
