{
  "$comment": "Performance budgets per key endpoint (Issue #237). Rationale per endpoint lives in docs/performance-budgets.md — update both together. p95/p99 in milliseconds, max_error_rate as a fraction (0.01 = 1%), min_rps is a throughput floor in requests/second for the given profile.",
  "version": 1,
  "global": {
    "p95_ms": 500,
    "p99_ms": 1000,
    "max_error_rate": 0.01
  },
  "endpoints": {
    "health_live": {
      "method": "GET",
      "path": "/health/live",
      "p95_ms": 50,
      "p99_ms": 100,
      "max_error_rate": 0.0,
      "min_rps": { "smoke": 2, "full": 5 }
    },
    "health_ready": {
      "method": "GET",
      "path": "/health/ready",
      "p95_ms": 150,
      "p99_ms": 300,
      "max_error_rate": 0.001,
      "min_rps": { "smoke": 1, "full": 2 }
    },
    "trades_list": {
      "method": "GET",
      "path": "/trades?page=1&limit=10",
      "p95_ms": 300,
      "p99_ms": 600,
      "max_error_rate": 0.01,
      "min_rps": { "smoke": 2, "full": 5 }
    },
    "trades_stats": {
      "method": "GET",
      "path": "/trades/stats",
      "p95_ms": 400,
      "p99_ms": 800,
      "max_error_rate": 0.01,
      "min_rps": { "smoke": 1, "full": 3 }
    },
    "trades_create": {
      "method": "POST",
      "path": "/trades",
      "p95_ms": 800,
      "p99_ms": 1500,
      "max_error_rate": 0.01,
      "min_rps": { "smoke": 0, "full": 2 },
      "profiles": ["full"]
    },
    "trades_deposit": {
      "method": "POST",
      "path": "/trades/:id/deposit",
      "p95_ms": 800,
      "p99_ms": 1500,
      "max_error_rate": 0.01,
      "min_rps": { "smoke": 0, "full": 2 },
      "profiles": ["full"]
    },
    "trades_confirm": {
      "method": "POST",
      "path": "/trades/:id/confirm",
      "p95_ms": 800,
      "p99_ms": 1500,
      "max_error_rate": 0.01,
      "min_rps": { "smoke": 0, "full": 2 },
      "profiles": ["full"]
    },
    "trades_dispute": {
      "method": "POST",
      "path": "/trades/:id/dispute",
      "p95_ms": 800,
      "p99_ms": 1500,
      "max_error_rate": 0.01,
      "min_rps": { "smoke": 0, "full": 2 },
      "profiles": ["full"]
    }
  }
}
