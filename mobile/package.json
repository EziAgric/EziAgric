{
  "name": "amana-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "eas build",
    "preview": "eas build --platform ios --profile preview",
    "prebuild": "expo prebuild --clean",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:ci": "jest --ci",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "test:e2e:build:ios": "detox build --configuration ios.sim.debug",
    "test:e2e:build:android": "detox build --configuration android.emu.debug"
  },
  "dependencies": {
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/stack": "^6.3.29",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-community/netinfo": "~12.0.1",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.2.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "axios": "^1.20.0",
    "expo": "^58.0.10",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~58.0.10",
    "expo-localization": "~57.0.2",
    "i18next": "^23.11.5",
    "react-i18next": "^14.1.2",
    "expo-device": "^57.0.2",
    "expo-notifications": "^57.0.22",
    "expo-secure-store": "^13.0.2",
    "expo-sqlite": "57.0.3",
    "react": "^18.3.1",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "^2.17.1",
    "react-native-safe-area-context": "^4.10.5",
    "react-native-screens": "^4.29.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@expo/config-plugins": "^58.0.9",
    "@types/jest": "^29.5.12",
    "@types/node": "^26.6.5",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "^18.3.3",
    "@types/react-native": "^0.73.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "detox": "20.51.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.10",
    "react-test-renderer": "^19.3.0",
    "ts-jest": "29.4.14",
    "typescript": "^6.0.3"
  }
}
