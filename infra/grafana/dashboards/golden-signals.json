{
  "title": "Amana — Golden Signals",
  "uid": "amana-golden-signals",
  "tags": ["amana", "golden-signals", "stored-as-code"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": "-- Grafana --",
        "enable": true,
        "iconColor": "rgba(255, 96, 96, 1)",
        "tags": ["deploy"],
        "type": "tags"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "API request rate (RPS)",
      "description": "Requests/sec by route, from OTel HTTP auto-instrumentation. Verify the exact metric name against your OTel SDK version via /metrics before trusting this panel — see docs/dashboards.md.",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_duration_milliseconds_count[5m])) by (http_route)",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "API latency p95 / p99",
      "description": "End-to-end HTTP server latency percentiles.",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_duration_milliseconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_duration_milliseconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Stellar transaction error rate",
      "description": "Share of Stellar transaction submissions (backend/src/lib/metrics.ts: stellar_transaction_submissions_total) that did not succeed, by operation.",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(stellar_transaction_submissions_total{outcome!=\"success\"}[5m])) by (operation) / sum(rate(stellar_transaction_submissions_total[5m])) by (operation)",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Soroban RPC health",
      "description": "Health check outcomes (backend/src/lib/metrics.ts: soroban_rpc_health_checks_total) and p95 latency of the health check itself.",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(soroban_rpc_health_checks_total{status=\"down\"}[5m]))",
          "legendFormat": "down checks/sec"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(soroban_rpc_health_check_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p95 latency (ms)"
        }
      ]
    },
    {
      "id": 5,
      "title": "Database saturation",
      "description": "Active vs. max Postgres connections. Requires postgres_exporter scraping the database alongside the app — see docs/dashboards.md prerequisites.",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count)",
          "legendFormat": "active connections"
        },
        {
          "expr": "pg_settings_max_connections",
          "legendFormat": "max connections"
        }
      ]
    },
    {
      "id": 6,
      "title": "Job queue depth",
      "description": "BullMQ waiting-job count by queue. Requires redis_exporter with a keyspace check pattern matching the bull:<queue>:wait lists — see docs/dashboards.md prerequisites.",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "redis_key_length_total{key=~\"bull:.*:wait\"}",
          "legendFormat": "{{key}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Stellar RPC call duration p95 by method",
      "description": "backend/src/lib/metrics.ts: stellar_rpc_duration_ms, per Soroban RPC method (sendTransaction, simulateTransaction, prepareTransaction, getAccount).",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(stellar_rpc_duration_ms_bucket[5m])) by (le, rpc_method))",
          "legendFormat": "{{rpc_method}}"
        }
      ]
    }
  ]
}
